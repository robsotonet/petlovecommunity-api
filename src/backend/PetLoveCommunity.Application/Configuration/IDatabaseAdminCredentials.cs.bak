namespace PetLoveCommunity.API.Configuration;

/// <summary>
/// Configuration interface for database administrator credentials.
/// </summary>
public interface IDatabaseAdminCredentials
{
    /// <summary>
    /// The administrator email address for database management tools.
    /// </summary>
    string Email { get; }
    
    /// <summary>
    /// The administrator password for database management tools.
    /// </summary>
    string Password { get; }
}